# 复制为 .env 后填写；不要把真实密钥提交到 Git。
# 首次修改后运行：npm run build:env，然后在扩展管理页重新加载扩展。

# false（默认）使用远程 LLM；仅 true / 1 / yes 时才使用下方 LOCAL_* 本地模型。
CONTEXTLENS_USE_LOCAL_MODEL=false

# 远程 LLM：优先使用 Key、Model 和 URL。custom 适用于任意 OpenAI 兼容服务。
# gemini | openai | claude | custom
CONTEXTLENS_API_PROVIDER=custom
CONTEXTLENS_API_KEY=
CONTEXTLENS_API_URL=https://your-llm-provider.example/v1
# 可选：完整请求地址。填写后原样请求，不会自动拼接 /chat/completions。
CONTEXTLENS_API_ENDPOINT=
CONTEXTLENS_MODEL=

# 额外预置模型：填写后会在 ContextAnswer 的主页下拉菜单和“设置 > 已保存模型”中出现。
# 供应商：gemini | openai | claude | custom | claude-agent | codex-agent | antigravity-agent | copilot-agent。
# 留空的槽位会被忽略；custom 需要 URL 或完整 Endpoint，Agent 使用 Bridge URL（未填时用 CONTEXTLENS_BRIDGE_URL）。
CONTEXTLENS_EXTRA_MODEL_1_NAME=
CONTEXTLENS_EXTRA_MODEL_1_PROVIDER=
CONTEXTLENS_EXTRA_MODEL_1_API_KEY=
CONTEXTLENS_EXTRA_MODEL_1_API_URL=
CONTEXTLENS_EXTRA_MODEL_1_API_ENDPOINT=
CONTEXTLENS_EXTRA_MODEL_1_MODEL=
CONTEXTLENS_EXTRA_MODEL_1_BRIDGE_URL=
CONTEXTLENS_EXTRA_MODEL_1_COMMAND_PATH=

# 可继续复制这一组，将编号改为 2、3、4 或 5。
CONTEXTLENS_EXTRA_MODEL_2_NAME=
CONTEXTLENS_EXTRA_MODEL_2_PROVIDER=
CONTEXTLENS_EXTRA_MODEL_2_API_KEY=
CONTEXTLENS_EXTRA_MODEL_2_API_URL=
CONTEXTLENS_EXTRA_MODEL_2_API_ENDPOINT=
CONTEXTLENS_EXTRA_MODEL_2_MODEL=

# auto（原生优先）| native（尽量原生）| in-page（默认，统一网页内可拖动面板）
CONTEXTLENS_PANEL_MODE=in-page

# 学习解释默认策略；面板中可为单次请求临时覆盖。
CONTEXTLENS_LEARNING_TRANSLATION_ENABLED=true
# 回答所用语言与翻译所用语言可分开；TARGET_LANGUAGE 保留给旧配置兼容。
CONTEXTLENS_LEARNING_RESPONSE_LANGUAGE=zh-CN
CONTEXTLENS_LEARNING_TRANSLATION_LANGUAGE=zh-CN
# compact | normal
CONTEXTLENS_LEARNING_RESPONSE_DETAIL=compact
# focus 为“结论优先”，standard 为较完整讲解；关键点限制为 2～5。
CONTEXTLENS_LEARNING_OUTPUT_STYLE=focus
CONTEXTLENS_LEARNING_MAX_KEY_POINTS=3
# never | on-demand | always
CONTEXTLENS_LEARNING_CODE_EXAMPLES=on-demand
# 单次学习任务的总时限；评估时限适用于每一次 0/5/10/20 行判断，单位毫秒。
CONTEXTLENS_LEARNING_REQUEST_TIMEOUT_MS=90000
CONTEXTLENS_LEARNING_ASSESSMENT_TIMEOUT_MS=15000
# auto 或下方支持的语言标识，例如 typescript、python、vue。
CONTEXTLENS_LEARNING_SOURCE_LANGUAGE=auto
# auto | manual | custom；manual 时使用 0（仅选区）/ 5 / 10 / 20 行，custom 由面板粘贴补充资料。
CONTEXTLENS_LEARNING_CONTEXT_MODE=auto
CONTEXTLENS_LEARNING_MANUAL_LINES=5
# 是否允许 auto 模式调用 Jev / LLM 评估选区充分性。
CONTEXTLENS_LEARNING_CONTEXT_ASSESSMENT_ENABLED=true

# 自动上下文判断：Jev 是主路线，LLM 是 Jev 低置信度、不可用或关闭时的回退路线。
# 两者都为 false 时，auto 模式不会判断或扩展上下文，只按当前选区回答并在界面提示。
CONTEXTLENS_JEV_ENABLED=false
CONTEXTLENS_JEV_API_KEY=
CONTEXTLENS_JEV_API_URL=https://api.typesafe.ai/v1/systemone
CONTEXTLENS_JEV_MODEL=jev-latest
# Choice 判断低于该置信度时，交给 LLM 回退路线；支持 0.50～0.95。
CONTEXTLENS_JEV_CONFIDENCE_THRESHOLD=0.75
CONTEXTLENS_LLM_ASSESSMENT_ENABLED=true

# 本地模型：只有 CONTEXTLENS_USE_LOCAL_MODEL=true 才会启用。
CONTEXTLENS_LOCAL_API_PROVIDER=custom
CONTEXTLENS_LOCAL_API_KEY=
CONTEXTLENS_LOCAL_API_URL=http://localhost:11434/v1
CONTEXTLENS_LOCAL_API_ENDPOINT=
CONTEXTLENS_LOCAL_MODEL=qwen2.5-coder:7b

# 本地 CLI Agent Bridge（仅在需要 Agent 修改本机代码时使用）
# true 时优先使用 Agent（即使 CONTEXTLENS_USE_LOCAL_MODEL=true）；provider 可为 claude-agent / codex-agent / antigravity-agent / copilot-agent。
CONTEXTLENS_USE_LOCAL_AGENT=false
CONTEXTLENS_LOCAL_AGENT_PROVIDER=codex-agent
CONTEXTLENS_LOCAL_AGENT_COMMAND_PATH=
CONTEXTLENS_BRIDGE_URL=http://localhost:3100
