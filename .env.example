# 复制为 .env 后填写；不要把真实密钥提交到 Git。
# 首次修改后运行：npm run build:env，然后在扩展管理页重新加载扩展。

# false（默认）使用远程 LLM；仅 true / 1 / yes 时才使用下方 LOCAL_* 本地模型。
CONTEXTLENS_USE_LOCAL_MODEL=false

# 远程 LLM：优先使用 Key、Model 和 URL。custom 适用于任意 OpenAI 兼容服务。
# gemini | openai | claude | custom
CONTEXTLENS_API_PROVIDER=custom
CONTEXTLENS_API_KEY=
CONTEXTLENS_API_URL=https://your-llm-provider.example/v1
# 可选：完整请求地址。填写后原样请求，不会自动拼接 /chat/completions。
CONTEXTLENS_API_ENDPOINT=
CONTEXTLENS_MODEL=

# 本地模型：只有 CONTEXTLENS_USE_LOCAL_MODEL=true 才会启用。
CONTEXTLENS_LOCAL_API_PROVIDER=custom
CONTEXTLENS_LOCAL_API_KEY=
CONTEXTLENS_LOCAL_API_URL=http://localhost:11434/v1
CONTEXTLENS_LOCAL_API_ENDPOINT=
CONTEXTLENS_LOCAL_MODEL=qwen2.5-coder:7b

# 本地 CLI Agent Bridge（仅在需要 Agent 修改本机代码时使用）
CONTEXTLENS_BRIDGE_URL=http://localhost:3100
